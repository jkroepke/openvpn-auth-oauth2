# vim:syntax=apparmor

abi <abi/3.0>,

include <tunables/global>

/usr/bin/openvpn-auth-oauth2 flags=(attach_disconnected) {
  include <abstractions/base>
  include <abstractions/nameservice>

  # The binary reads itself at startup (google.golang.org/protobuf/internal/detrand
  # hashes the executable, pulled in via CEL).
  /usr/bin/openvpn-auth-oauth2 mr,

  @{PROC}/sys/kernel/core_pattern r,
  # Go runtime: listen backlog size (net package).
  @{PROC}/sys/net/core/somaxconn r,

  # Go runtime (>= 1.25): container-aware GOMAXPROCS reads the CPU limit of the cgroup.
  @{PROC}/@{pid}/{cgroup,mountinfo} r,
  @{sys}/fs/cgroup/{,**} r,

  @{etc_ro}/openvpn-auth-oauth2/** r,

  # Management interface and plugin sockets. @{run} covers /run and /var/run.
  # Runtime directories of the Debian/Ubuntu openvpn@.service, openvpn-server@.service
  # and the openvpn-auth-oauth2.service (RuntimeDirectory=).
  @{run}/openvpn{,-server,-auth-oauth2}/ r,
  @{run}/openvpn{,-server,-auth-oauth2}/* rw,
  # Sockets placed directly in /run, e.g. unix:///run/openvpn.sock or unix:///var/run/openvpn-oauth2.sock
  @{run}/openvpn{,-server,-oauth2,-auth-oauth2}.sock rw,
  # Relative "management <file> unix" paths resolve against the working directory
  # of the Debian/Ubuntu units: /etc/openvpn (openvpn@) and /etc/openvpn/server (openvpn-server@).
  @{etc_ro}/openvpn/{,server/}*.sock rw,

  @{etc_ro}/mime.types r,
  /usr/share/mime/* r,

  @{sys}/kernel/mm/{hugepages,transparent_hugepage}/{,**} r,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/usr.bin.openvpn-auth-oauth2>
}
